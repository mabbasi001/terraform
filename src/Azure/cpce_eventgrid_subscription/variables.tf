variable "eventgrid_topic_id" {
  description = "The id of the topic to make a subscription to"
  type        = string
}

variable "dead_letter_endpoint" {
  description = "The endpoint of the deadletter container"
  type = object(
    {
      storage_account_id  = string
      blob_container_name = string
    }
  )
}

variable "storage_queue_endpoint" {
  description = "The endpoint of the storage queue"
  type = object(
    {
      storage_account_id = string
      queue_name         = string
    }
  )
}

variable "customer_code" {
  description = "The code of the customer for which this resource was created"
  type        = string
  default     = null
}

variable "environment_code" {
  description = "A code for the environment in which the resource is being created (e.g. \"BVT\" or \"UAT\")"
  type        = string
  default     = null

}

variable "name_suffix" {
  description = "The suffix to be appended to the auto-generated name of the resource"
  type        = string
  default     = null
}


variable "name" {
  description = "An override of the default name that would be generated by this module"
  type        = string
  default     = null
}

variable "included_event_types" {
  description = "List of event types that the subscription should send to the handler"
  type        = list(string)
  default     = null
}

variable "expiration_time_utc" {
  description = "The expiration date and time of the event subscription"
  type        = string
  default     = null
}

variable "event_delivery_schema" {
  description = "The schema of the events that will be delivered to the event hander"
  type        = string
  default     = "EventGridSchema"
}

variable "retry_policy" {
  description = "An object specifying the policy for how long the Event Subscription should continue to try delivering"
  type = object(
    {
      max_delivery_attempts = number
      event_time_to_live    = number
    }
  )
  default = null
}

variable "subject_filter" {
  description = "The Event Subscription should only deliver events whose subject matches the filter parameters"
  type = object(
    {
      subject_begins_with = string
      subject_ends_with   = string
      case_sensitive      = bool
    }
  )
  default = null
}
